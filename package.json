{
  "name": "@ddtcorex/dsh-maestro-supervisor",
  "version": "0.8.4",
  "description": "Supervisor daemon for DSH Web resilience — auto-detect crashes, rollback to LKG, report",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddtcorex/dsh-maestro-supervisor.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/auto-reload.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-web-supervisor": "./lib/bin.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "skills",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "verify": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run --testTimeout=10000",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ddtcorex/dsh-maestro-config-lib": "workspace:^0.2.0",
    "fzstd": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.7.0"
}
